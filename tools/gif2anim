#!/usr/bin/env python3
"""Convert an animated GIF (or any image sequence) into a moofetch `.anim` file.

Frames are extracted with ImageMagick and rendered to ANSI text with chafa.
The resulting file can be used with:

    moofetch --logo-type animation --logo my.anim

Requires: ImageMagick (`magick` or `convert`) and `chafa`.
"""

import argparse
import math
import os
import re
import shutil
import subprocess
import sys
import tempfile


def find_tool(*names):
    for name in names:
        path = shutil.which(name)
        if path:
            return path
    return None


def fail(message):
    print(f"error: {message}", file=sys.stderr)
    return 1


def run(command, **kwargs):
    try:
        return subprocess.run(command, check=True, capture_output=True, text=True, **kwargs)
    except subprocess.CalledProcessError as error:
        detail = (error.stderr or error.stdout or "").strip()
        raise RuntimeError(f"`{' '.join(command[:2])} ...` failed: {detail[:300]}") from error


def image_size(magick, path):
    result = run([magick, "identify", "-format", "%w %h", f"{path}[0]"])
    width, height = result.stdout.split()
    return int(width), int(height)


def validate(anim_path, moofetch):
    """Validate a .anim file with moofetch's real parser."""
    if not moofetch:
        print("warning: moofetch binary not found, skipping validation", file=sys.stderr)
        return True
    result = subprocess.run(
        [moofetch, "--logo-type", "animation", "--logo", anim_path, "--pipe", "--show-errors", "true"],
        capture_output=True, text=True,
    )
    errors = [line for line in result.stderr.splitlines() if line.startswith("Logo:")]
    for line in errors:
        print(f"error: {line}", file=sys.stderr)
    return not errors


def summarize(anim_path):
    with open(anim_path, encoding="utf-8") as file:
        content = file.read()
    frames = content.count("\n---\n") + (1 if content.startswith("---\n") else 0)
    widths = []
    for line in content.splitlines():
        if line.startswith("---") or line.startswith("!") or line.startswith("#"):
            continue
        visible = re.sub(r"\x1b\[[0-9;]*[A-Za-z]", "", line)
        visible = re.sub(r"\$[0-9]", "", visible)
        widths.append(len(visible))
    return frames, max(widths, default=0)


def check_mode(args):
    if not os.path.isfile(args.input):
        return fail(f"no such file: {args.input}")
    moofetch = args.moofetch or find_tool("moofetch")
    if not validate(args.input, moofetch):
        return 1
    frames, width = summarize(args.input)
    print(f"{args.input}: valid ({frames} frame{'s' if frames != 1 else ''}, {width} columns)")
    return 0


def convert(args):
    if not os.path.isfile(args.input):
        return fail(f"no such file: {args.input}")

    magick = find_tool("magick", "convert")
    if not magick:
        return fail("ImageMagick is required (install the `magick` or `convert` command)")

    chafa = find_tool("chafa")
    if not chafa:
        return fail("chafa is required (https://hpjansson.org/chafa/)")

    with tempfile.TemporaryDirectory(prefix="gif2anim-") as workdir:
        frame_pattern = os.path.join(workdir, "frame_%04d.png")
        try:
            run([magick, args.input, "-coalesce", frame_pattern])
        except RuntimeError as error:
            return fail(str(error))

        frames = sorted(f for f in os.listdir(workdir) if f.startswith("frame_"))
        if not frames:
            return fail(f"could not extract any frame from {args.input}")

        first = os.path.join(workdir, frames[0])
        image_width, image_height = image_size(magick, first)
        width = args.width
        # Terminal cells are roughly twice as tall as wide
        height = args.height or max(1, round(width * image_height / image_width / 2))

        rendered = []
        for name in frames:
            path = os.path.join(workdir, name)
            command = [
                chafa,
                f"--size={width}x{height}",
                f"--symbols={args.symbols}",
                "--colors=full",
                "--format=symbols",
                "--animate=off",
            ]
            if args.fg_only:
                command.append("--fg-only")
            command.append(path)
            try:
                result = run(command)
            except RuntimeError as error:
                return fail(str(error))
            rendered.append(result.stdout.rstrip("\n"))

    output = args.output or os.path.splitext(args.input)[0] + ".anim"
    if os.path.exists(output) and not args.force:
        return fail(f"{output} already exists (use --force to overwrite)")

    lines = []
    if args.title:
        lines.append(f"# {args.title}")
    lines.append("# Generated by tools/gif2anim")
    lines.append(f"!fps {args.fps}")
    lines.append(f"!loop {args.loop}")
    if args.loop == 0:
        lines.append(f"!timeout {args.timeout}")
    if args.hold:
        lines.append(f"!hold {args.hold}")
    for frame in rendered:
        lines.append("---")
        lines.append(frame)
    with open(output, "w", encoding="utf-8") as file:
        file.write("\n".join(lines) + "\n")

    moofetch = args.moofetch or find_tool("moofetch")
    valid = validate(output, moofetch)
    print(f"wrote {output} ({len(rendered)} frames, {width}x{height} cells)")
    return 0 if valid else 1


def main():
    parser = argparse.ArgumentParser(
        description="Convert an animated GIF into a moofetch .anim file.",
        epilog="Example: python3 tools/gif2anim input.gif -o logo.anim --width 30 --fps 12",
    )
    parser.add_argument("input", help="input GIF or image sequence")
    parser.add_argument("-o", "--output", help="output .anim path (default: input name with .anim)")
    parser.add_argument("--width", type=int, default=40, help="output width in terminal cells (default: 40)")
    parser.add_argument("--height", type=int, help="output height in cells (default: derived from aspect ratio)")
    parser.add_argument("--fps", type=int, default=12, help="!fps directive (default: 12)")
    parser.add_argument("--loop", type=int, default=2, help="!loop directive; 0 = infinite (default: 2)")
    parser.add_argument("--timeout", type=int, default=5000, help="!timeout directive for --loop 0 (default: 5000)")
    parser.add_argument("--hold", choices=["first", "last"], help="!hold directive (default: omit)")
    parser.add_argument("--symbols", default="block+border+space-wide-inverted", help="chafa symbol set")
    parser.add_argument("--fg-only", action="store_true", help="use foreground colors only (smaller files)")
    parser.add_argument("--title", help="add a title comment to the generated file")
    parser.add_argument("--force", action="store_true", help="overwrite an existing output file")
    parser.add_argument("--moofetch", help="path to the moofetch binary used for validation")
    parser.add_argument("--check", action="store_true", help="validate an existing .anim file instead of converting")
    args = parser.parse_args()

    if not 1 <= args.fps <= 60:
        return fail("--fps must be between 1 and 60")
    if not 0 <= args.loop <= 1000:
        return fail("--loop must be between 0 and 1000")
    if args.width < 1 or (args.height is not None and args.height < 1):
        return fail("--width and --height must be positive")

    return check_mode(args) if args.check else convert(args)


if __name__ == "__main__":
    sys.exit(main())
