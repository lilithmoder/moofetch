# Maintainer: lilithmoder <https://github.com/lilithmoder>
# Note: the AUR requires a valid email address in the Maintainer line before submitting.
pkgname=moofetch-git
pkgver=r0.1.0.2.g75156eb
pkgrel=1
pkgdesc="System information tool with animated ASCII logos (fastfetch fork)"
arch=('x86_64' 'aarch64')
url="https://github.com/lilithmoder/moofetch"
license=('MIT')
depends=('glibc')
makedepends=('cmake' 'gcc' 'python')
provides=('moofetch')
conflicts=('moofetch')
source=("$pkgname::git+${url}.git")
b2sums=('SKIP')

pkgver() {
    cd "$pkgname"
    printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
    cd "$pkgname"
    cmake -B build -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build build -j"$(nproc)"
}

check() {
    cd "$pkgname"
    python3 tests/pty_smoke.py build/moofetch
}

package() {
    cd "$pkgname"
    DESTDIR="$pkgdir" cmake --install build
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
